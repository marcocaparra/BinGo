{
  "name": "BinGo Project",
  "dockerComposeFile": "../docker-compose.yml", // Caminho para o seu docker-compose.yml
  "service": "backend",                        // Qual serviço no docker-compose.yml deve ser o ambiente principal
  "workspaceFolder": "/app",                   // Diretório de trabalho dentro do contêiner do backend

  // Portas que o Codespaces deve encaminhar automaticamente
  "forwardPorts": [8000, 3306], 

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-azuretools.vscode-docker"
      ]
    }
  },
  
  // Opcional: Comandos a serem executados após a criação do Codespace
  "postCreateCommand": "python -m pip install --upgrade pip && pip install -r backend/requirements.txt && alembic upgrade head"
  // O postCreateCommand pode ser usado para instalar dependências e rodar migrações
  // Atenção: O `alembic upgrade head` deve ser executado no ambiente do `backend` depois que o `db` estiver pronto.
  // Você pode precisar de um script auxiliar se houver problemas de tempo.
}