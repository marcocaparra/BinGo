{
  "name": "BinGo Dev Environment",
  "dockerComposeFile": "../docker-compose.yml",
  "service": "backend-dev",
  "workspaceFolder": "/app",
  "forwardPorts": [
    8000,
    3306,
    5173
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-azuretools.vscode-docker"
      ]
    }
  },
  "postCreateCommand": "pip install -r requirements-dev.txt && alembic upgrade head"
}