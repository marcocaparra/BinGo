{
  "name": "BinGo Project",
  "dockerComposeFile": "../docker-compose.yml",
  "service": "backend",
  "workspaceFolder": "/app",

  "forwardPorts": [8000, 3306], 

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-azuretools.vscode-docker"
      ]
    }
  },
  

  "postCreateCommand": "python -m pip install --upgrade pip && pip install -r backend/requirements.txt && alembic upgrade head"
  
  
  
}