g# Copy to .env locally; never commit secrets. Empty credentials keep safe mode.
# Values with $/#/spaces should be single-quoted to preserve the exact key.
BINGO_SUPABASE_URL=
BINGO_MACHINE_ID=
BINGO_MACHINE_API_KEY=
BINGO_BACKEND_TIMEOUT_SECONDS=5
BINGO_HTTP_PORT=8000
# Absolute path INSIDE the persistent mount; keep it stable across updates.
BINGO_SQLITE_PATH=/var/lib/bingo/totem.sqlite3
# Visão interna opcional, somente backend. Não habilita operação física.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=sa-east-1
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
BINGO_GEMINI_TIMEOUT_SECONDS=10
BINGO_GEMINI_TRANSIENT_RETRIES=1
