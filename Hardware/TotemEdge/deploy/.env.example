# Copy to .env locally; never commit secrets. Empty credentials keep safe mode.
# Values with $/#/spaces should be single-quoted to preserve the exact key.
BINGO_SUPABASE_URL=
BINGO_MACHINE_ID=
BINGO_MACHINE_API_KEY=
BINGO_BACKEND_TIMEOUT_SECONDS=5
BINGO_HTTP_PORT=8000
# Absolute path INSIDE the persistent mount; keep it stable across updates.
BINGO_SQLITE_PATH=/var/lib/bingo/totem.sqlite3
