BINGO_SQLITE_PATH=/var/lib/bingo/python/totem.sqlite3
BINGO_C_CONTROLLER_CONFIG=/etc/bingo/physical/controller.json
# Uses the existing camera bridge; no /dev/video access in the mechanical service.
BINGO_CAMERA_MODE=remote
BINGO_CAMERA_URL=http://127.0.0.1:8010
BINGO_CAMERA_TOKEN_FILE=/etc/bingo/camera.token
