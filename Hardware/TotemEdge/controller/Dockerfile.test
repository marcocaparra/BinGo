# Test-only toolchain, never an operational image. Context: Hardware/TotemEdge.
FROM ghcr.io/astral-sh/uv:0.12.19@sha256:04d046b13e60d6bcec73cbc5e1cad25d680dea90c8573340950a0ac2d1aef424 AS uv
FROM python:3.12.15-slim-bookworm@sha256:34386ef0cb081344d7ec1c103ba398e6e9f64e9ab3a1509accc92a4e24a07258
RUN apt-get update && apt-get install -y --no-install-recommends gcc libc6-dev libsqlite3-dev \
    && rm -rf /var/lib/apt/lists/*
COPY --from=uv /uv /bin/uv
ENV UV_PROJECT_ENVIRONMENT=/opt/venv UV_PYTHON_DOWNLOADS=never \
    PATH="/opt/venv/bin:$PATH" PYTHONDONTWRITEBYTECODE=1
WORKDIR /work/backend
COPY backend/pyproject.toml backend/uv.lock ./
RUN uv sync --locked --no-install-project --no-editable --no-build
COPY backend/app ./app
COPY backend/tests ./tests
COPY controller /work/controller
RUN useradd --uid 10001 --no-create-home testuser
USER 10001:10001
CMD ["python", "-m", "pytest", "-q", "-p", "no:cacheprovider", "tests/test_c_controller.py", "tests/test_c_controller_doorless.py", "tests/test_c_controller_physical.py", "--tb=short"]
