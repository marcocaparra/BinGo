# Copie para .env e preencha as três variáveis obrigatórias somente no backend.
# Não use service role, Secret API Key Supabase nem credenciais no frontend.
BINGO_SUPABASE_URL=
BINGO_MACHINE_ID=
BINGO_MACHINE_API_KEY=

# Limite técnico desta implementação por consulta; não é SLO ou polling oficial.
BINGO_BACKEND_TIMEOUT_SECONDS=5
# Caminho local persistente (opcional). Sem PIN, credenciais ou imagens.
BINGO_SQLITE_PATH=.data/totem.sqlite3

# Visão interna opcional. Não habilita ONLINE, captura ou descarte.
# Credenciais explícitas; não há descoberta automática de perfil/IMDS.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=sa-east-1
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
# Timeout máximo 10s/tentativa; no máximo uma nova tentativa transitória.
BINGO_GEMINI_TIMEOUT_SECONDS=10
BINGO_GEMINI_TRANSIENT_RETRIES=1
